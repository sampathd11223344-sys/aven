<%- include('partials/head', { title: 'Document not available' }) %>
<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><%- icon('home') %> Home</a><span>/</span><span aria-current="page">Document not available</span></nav>
      <h1>This page isn’t available</h1>
      <p class="page-sub"><strong><%= fileName %></strong> is linked from the college’s website, but it is not on their server right now.</p>
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      <div class="card">
        <p>The college’s own website returns “not found” for this link, so the file or page cannot be shown. The link is kept exactly as the college published it, so it will work again as soon as they restore the file.</p>
        <p class="muted"><small>Requested path: <code><%= rel %></code></small></p>
        <div class="missing-actions">
          <a class="btn btn-primary" href="/">Back to home</a>
          <a class="btn btn-outline" href="/search">Search the website</a>
          <a class="btn btn-ghost" href="<%= original %>" target="_blank" rel="noopener">Try the original link</a>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
